{
  "name": "wpai",
  "version": "1.3.1",
  "description": "WPAI Windows onboarding, WhatsApp Business and controlled AI management panel",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "concurrently -k -n WEB,WORKER \"vite\" \"wrangler dev\"",
    "build": "vite build",
    "types": "wrangler types worker-configuration.d.ts --experimental-provision=false --experimental-auto-create=false",
    "typecheck": "npm run types && tsc -p tsconfig.frontend.json --noEmit && tsc -p tsconfig.worker.json --noEmit && tsc -p tsconfig.tests.json --noEmit",
    "test": "npm run test:unit && npm run test:worker",
    "test:unit": "vitest run --config vitest.node.config.ts",
    "test:worker": "vitest run --config vitest.worker.config.ts",
    "security:scan": "node scripts/scan-secrets.mjs",
    "validate": "python scripts/validate.py && python scripts/validate_spec500.py",
    "check": "npm run security:scan && npm run validate && npm run typecheck && npm run test && npm run build && npm run deploy:dry",
    "deploy:dry": "npm run build && wrangler deploy --dry-run --strict --experimental-provision=false --experimental-auto-create=false",
    "deploy": "npm run build && wrangler deploy --strict --experimental-provision=false --experimental-auto-create=false",
    "db:local": "wrangler d1 migrations apply wa-ai-prod --local --experimental-provision=false --experimental-auto-create=false",
    "db:remote": "wrangler d1 migrations apply wa-ai-prod --remote --experimental-provision=false --experimental-auto-create=false",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build",
    "sidecar:test": "python -m pytest -q sidecar/test_faiss_service.py"
  },
  "dependencies": {
    "@hono/zod-validator": "0.7.2",
    "@tauri-apps/api": "2.11.1",
    "hono": "4.12.34",
    "lucide-react": "0.468.0",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.20.1",
    "@tauri-apps/cli": "2.11.1",
    "@types/node": "22.17.0",
    "@types/react": "19.1.9",
    "@types/react-dom": "19.1.7",
    "@vitejs/plugin-react": "4.7.0",
    "@vitest/coverage-v8": "4.1.10",
    "concurrently": "9.2.4",
    "typescript": "5.9.2",
    "vite": "7.3.6",
    "vitest": "4.1.10",
    "wrangler": "4.118.0"
  },
  "overrides": {
    "undici": "7.29.0"
  },
  "packageManager": "npm@10.9.8"
}
