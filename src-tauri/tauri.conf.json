{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WPAI",
  "version": "1.2.0",
  "identifier": "com.wpai.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist/web"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "WPAI - WhatsApp ve AI Yönetimi",
        "url": "https://wa-ai-panel.wa-ai-panel.workers.dev/",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 680,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "capabilities": ["wpai-remote-production"],
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' https://wa-ai-panel.wa-ai-panel.workers.dev https://graph.facebook.com https://api.cloudflare.com; frame-ancestors 'none'; base-uri 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "WPAI",
    "category": "Business",
    "shortDescription": "WhatsApp müşteri görüşmeleri ve AI yönetimi",
    "longDescription": "Cloudflare üzerinde çalışan WhatsApp Business ve yapay zekâ yönetim panelinin güvenli Windows istemcisi.",
    "externalBin": ["bin/faiss-service"],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true },
      "nsis": {
        "displayLanguageSelector": true,
        "installerMode": "currentUser",
        "languages": ["Turkish", "English"]
      }
    }
  }
}
